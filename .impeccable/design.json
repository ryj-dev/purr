      "css": ".ds-btn{font:650 13px/1 'Overpass Variable',Overpass,system-ui,sans-serif;height:30px;padding:1px 12px 0;border-radius:var(--r,6px);border:1px solid var(--border-2,rgba(16,22,30,.16));background:var(--surface,#fff);color:var(--text,#12161b);cursor:pointer;transition:background .15s,border-color .15s}.ds-btn-primary{background:var(--ink,#12161b);border-color:var(--ink,#12161b);color:var(--ink-fg,#fff)}.ds-btn-primary:hover{background:var(--ink-hover,#2b313a);border-color:var(--ink-hover,#2b313a)}.ds-btn:focus-visible{outline:2px solid var(--focus,rgba(18,22,27,.5));outline-offset:2px}"
    },
